---
import { localeUrl } from '../lib/url';
import { site, t, defaultLocale, type Locale } from '../data/site';
import LangToggle from './LangToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import CoffeeLink from './CoffeeLink.astro';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const c = t(locale);

// Active tab by first path segment, base- and locale-stripped.
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.replace(base, '/').replace(/^\/(pt)(?=\/|$)/, '/').replace(/\/+/g, '/');
const seg = '/' + (path.split('/').filter(Boolean)[0] ?? '');
const tabs = c.nav.filter((tab) => tab.href !== '/');
---

<nav class="sticky top-0 z-20 border-b border-line bg-bg/85 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3">
    <a href={localeUrl(locale, '/')} class="group flex items-center gap-2.5 text-ink" aria-current={seg === '/' ? 'page' : undefined}>
      <svg viewBox="0 0 32 32" class="h-7 w-7 transition-transform duration-500 group-hover:rotate-45" aria-hidden="true">
        <g stroke="var(--ink)" stroke-width="1.6" stroke-linecap="round" opacity="0.7">
          <path d="M16 16 L5 6" /><path d="M16 16 L27 8" /><path d="M16 16 L28 21" /><path d="M16 16 L9 27" />
        </g>
        <circle cx="16" cy="16" r="4.5" fill="var(--sun)" />
      </svg>
      <span class="sr-only">{site.brand}</span>
      <span aria-hidden="true" class="hidden font-display text-xl font-extrabold tracking-wide sm:inline">{site.brand}</span>
    </a>
    <div class="flex items-center gap-1.5 sm:gap-4">
      <div class="flex">
        {
          tabs.map((tab) => {
            const on = seg === tab.href;
            return (
              <a
                href={localeUrl(locale, tab.href)}
                aria-current={on ? 'page' : undefined}
                class:list={[
                  'relative px-1.5 py-1.5 font-display text-lg font-semibold tracking-wide transition-colors hover:text-sun sm:px-3',
                  on ? 'text-sun' : 'text-ink',
                ]}
              >
                {tab.label}
              </a>
            );
          })
        }
      </div>
      <LangToggle />
      <CoffeeLink compact />
      <ThemeToggle />
    </div>
  </div>
</nav>
