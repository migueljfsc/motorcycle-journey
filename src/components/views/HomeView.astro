---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TripCard from '../TripCard.astro';
import BikeCard from '../BikeCard.astro';
import SpokeMap from '../SpokeMap.astro';
import { localeUrl } from '../../lib/url';
import { t, type Locale } from '../../data/site';
import { localeTrips, mapTrips, tripSlug } from '../../lib/trips';
import { origin, tripPlaces, crowFliesKm } from '../../data/places';
import { rideTotals } from '../../data/rides';
import { fmtKm } from '../../lib/format';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = t(locale);

const trips = await localeTrips(locale);
const latest = trips.slice(0, c.home.latestTripsCount);

// Home shows only bikes currently owned.
const bikes = await getCollection('bikes', ({ data }) => !data.draft && data.status === 'owned');

const farthest = trips
  .map((tr) => tripPlaces[tripSlug(tr)])
  .filter(Boolean)
  .map((p) => ({ label: p.label, km: Math.round(crowFliesKm(origin, p)) }))
  .sort((a, b) => b.km - a.km)[0];

const totals = trips.map((tr) => rideTotals(tripSlug(tr))).filter((x) => x !== undefined);
const kmRidden = totals.reduce((s, r) => s + r.km, 0);
const hoursMoving = Math.round(totals.reduce((s, r) => s + r.movingSec, 0) / 3600);

const stats = [
  { value: String(trips.length), label: c.home.stats.rides },
  { value: fmtKm(kmRidden, locale), label: c.home.stats.ridden },
  { value: `${hoursMoving} h`, label: c.home.stats.saddle },
  ...(farthest ? [{ value: `${farthest.km} km`, label: `${c.home.stats.farthest}, ${farthest.label}` }] : []),
];
---

<Layout wide>
  <section class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-14">
    <div class="hero-copy">
      <h1 class="font-display text-[clamp(3.2rem,8vw,6.4rem)] leading-[0.88] font-black tracking-tight text-ink">
        {c.home.heading}
      </h1>
      <p class="mt-6 max-w-[34ch] text-xl leading-relaxed text-muted">{c.home.intro}</p>
      <dl class="mt-9 flex flex-wrap gap-x-9 gap-y-4">
        {
          stats.map((s) => (
            <div>
              <dt class="sr-only">{s.label}</dt>
              <dd class="font-display text-4xl font-extrabold leading-none text-sun">{s.value}</dd>
              <dd class="label mt-1 text-muted">{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <SpokeMap trips={mapTrips(trips, locale)} />
  </section>

  <section class="mt-24">
    <div class="mb-6 flex items-baseline justify-between gap-4 border-b border-line pb-3">
      <h2 class="font-display text-4xl font-extrabold tracking-tight">{c.home.trips.title}</h2>
      <a href={localeUrl(locale, '/trips')} class="label text-muted transition-colors hover:text-sun">{c.home.trips.link}</a>
    </div>
    <div class="grid gap-x-8 gap-y-12 sm:grid-cols-2">
      {latest.map((trip) => <TripCard trip={trip} />)}
    </div>
  </section>

  <section class="mt-24">
    <div class="mb-6 flex items-baseline justify-between gap-4 border-b border-line pb-3">
      <h2 class="font-display text-4xl font-extrabold tracking-tight">{c.home.bikes.title}</h2>
      <a href={localeUrl(locale, '/bikes')} class="label text-muted transition-colors hover:text-sun">{c.home.bikes.link}</a>
    </div>
    <div class="grid gap-8">
      {bikes.map((bike) => <BikeCard bike={bike} feature />)}
    </div>
  </section>
</Layout>

<style>
  .hero-copy { animation: rise 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
</style>
