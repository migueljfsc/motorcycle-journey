---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BikeCard from '../BikeCard.astro';
import { t, type Locale } from '../../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = t(locale);

const bikes = await getCollection('bikes', ({ data }) => !data.draft);

// Group in catalog order, dropping empty groups.
const groups = c.bikeGroups
  .map((g) => ({ status: g.status, label: g.label, items: bikes.filter((b) => b.data.status === g.status) }))
  .filter((x) => x.items.length > 0);
---

<Layout title={c.pages.bikes.title} description={c.pages.bikes.description} wide>
  <header class="mb-14">
    <h1 class="font-display text-[clamp(3rem,7vw,5.5rem)] leading-[0.9] font-black">{c.pages.bikes.heading}</h1>
    <p class="mt-4 max-w-[46ch] text-xl text-muted">{c.pages.bikes.description}</p>
  </header>

  {
    groups.map((g) => (
      <section class="mb-20">
        <h2 class="mb-8 border-b border-line pb-3 font-display text-4xl font-extrabold">{g.label}</h2>
        {g.status === 'owned' ? (
          <div class="grid gap-14">
            {g.items.map((bike) => (
              <div id={bike.id} class="scroll-mt-24">
                <BikeCard bike={bike} feature />
              </div>
            ))}
          </div>
        ) : (
          <div class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
            {g.items.map((bike) => (
              <div id={bike.id} class="scroll-mt-24">
                <BikeCard bike={bike} />
              </div>
            ))}
          </div>
        )}
      </section>
    ))
  }
</Layout>
