---
import Layout from '../../layouts/Layout.astro';
import TripCard from '../TripCard.astro';
import { t, type Locale } from '../../data/site';
import { localeTrips } from '../../lib/trips';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = t(locale);

const trips = await localeTrips(locale);

// Group by year (newest first).
const years = [...new Set(trips.map((tr) => tr.data.date.getFullYear()))].sort((a, b) => b - a);
const byYear = years.map((year) => ({
  year,
  trips: trips.filter((tr) => tr.data.date.getFullYear() === year),
}));
---

<Layout title={c.pages.trips.title} description={c.pages.trips.description} wide>
  <header class="mb-14">
    <h1 class="font-display text-[clamp(3rem,7vw,5.5rem)] leading-[0.9] font-black">{c.pages.trips.heading}</h1>
    <p class="mt-4 max-w-[46ch] text-xl text-muted">{c.pages.trips.description}</p>
  </header>

  {
    byYear.map((group) => (
      <section id={`year-${group.year}`} class="mb-20 scroll-mt-24">
        <h2 class="mb-8 flex items-baseline gap-4 border-b border-line pb-3 font-display text-5xl font-black text-sun">
          {group.year}
          <span class="label text-faint">{group.trips.length} {c.home.stats.rides}</span>
        </h2>
        <div class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
          {group.trips.map((trip) => <TripCard trip={trip} />)}
        </div>
      </section>
    ))
  }
</Layout>
