---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { fmtDate } from '../../lib/format';
import { localeUrl } from '../../lib/url';
import { t, type Locale } from '../../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = t(locale);

const tips = (
  await getCollection('tips', ({ id, data }) => !data.draft && id.startsWith(`${locale}/`))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title={c.pages.tips.title} description={c.pages.tips.description} wide>
  <header class="mb-14">
    <h1 class="font-display text-[clamp(3rem,7vw,5.5rem)] leading-[0.9] font-black">{c.pages.tips.heading}</h1>
    <p class="mt-4 max-w-[46ch] text-xl text-muted">{c.pages.tips.description}</p>
  </header>

  <ul class="border-t border-line">
    {
      tips.map((tip) => {
        const slug = tip.id.replace(/^[a-z]{2}\//, '');
        return (
          <li id={slug} class="scroll-mt-24 border-b border-line">
            <a
              href={localeUrl(locale, `/tips/${slug}`)}
              class="group -mx-4 grid gap-2 rounded px-4 py-7 text-ink transition-colors hover:bg-surface md:grid-cols-[10rem_minmax(0,1fr)] md:gap-8"
            >
              <span class="label pt-1.5 text-faint">{fmtDate(tip.data.date, locale)}</span>
              <span>
                <span class="block font-display text-3xl font-extrabold leading-tight transition-colors group-hover:text-sun">
                  {tip.data.title}
                </span>
                <span class="mt-1 block max-w-[60ch] text-muted">{tip.data.description}</span>
                {tip.data.tags.length > 0 && (
                  <span class="label mt-3 flex flex-wrap gap-3 text-sun">
                    {tip.data.tags.map((tag) => <span>#{tag}</span>)}
                  </span>
                )}
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</Layout>
