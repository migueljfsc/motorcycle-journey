---
import { site, t, defaultLocale, type Locale } from '../data/site';
import CoffeeLink from './CoffeeLink.astro';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const c = t(locale);
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto grid max-w-6xl items-end gap-6 px-5 py-10 sm:grid-cols-[1fr_auto_1fr]">
    <div>
      <p class="font-display text-3xl font-extrabold tracking-wide text-ink">{c.footerTagline}.</p>
      <p class="label mt-1 text-faint">© {year} {site.name}</p>
    </div>
    <a
      href="https://migueljfsc.dev/"
      target="_blank"
      rel="noopener"
      class="label justify-self-start text-lg text-muted underline decoration-sun decoration-2 underline-offset-4 transition-colors hover:text-sun sm:justify-self-center"
    >
      {c.footerAbout}
    </a>
    <div class="sm:justify-self-end">
      <CoffeeLink />
    </div>
  </div>
</footer>
