---
import { t, defaultLocale, type Locale } from '../data/site';
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const c = t(locale);
---

<button
  type="button"
  data-theme-toggle
  aria-label={c.ui.themeToggle}
  title={c.ui.themeToggle}
  class="grid h-9 w-9 cursor-pointer place-items-center rounded-full border border-line text-muted transition-colors hover:border-sun hover:text-sun"
>
  <svg class="theme-sun h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <svg class="theme-moon h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
  </svg>
</button>

<style>
  button svg { grid-area: 1 / 1; transition: opacity 0.2s, transform 0.3s; }
  .theme-sun { opacity: 0; transform: rotate(-60deg) scale(0.7); }
  :global([data-theme='light']) .theme-sun { opacity: 1; transform: none; }
  :global([data-theme='light']) .theme-moon { opacity: 0; transform: rotate(60deg) scale(0.7); }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try {
        localStorage.setItem('moto-theme', next);
      } catch {}
    }),
  );
</script>
