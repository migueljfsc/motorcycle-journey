---
import { media } from '../lib/url';
import { photoPosition } from '../data/media';

interface Props {
  images: string[];
  alt?: string;
}
const { images, alt = '' } = Astro.props;
const single = images.length <= 1;
---

<div
  class="moto-carousel relative overflow-hidden rounded border border-line bg-surface"
  data-carousel
>
  <div
    class="track flex aspect-[3/2] snap-x snap-mandatory overflow-x-auto scroll-smooth"
    data-track
  >
    {
      images.map((src) => (
        <img
          src={media(src)}
          alt={alt}
          style={`object-position: ${photoPosition[src] ?? 'center'}`}
          class="aspect-[3/2] w-full min-w-0 shrink-0 grow-0 basis-full cursor-zoom-in snap-center object-cover"
          loading="lazy"
          data-slide-img
        />
      ))
    }
  </div>

  {
    !single && (
      <>
        <button
          type="button"
          data-prev
          aria-label="Previous photo"
          class="absolute left-2 top-1/2 -translate-y-1/2 rounded-full border border-line bg-bg/80 px-3 py-1.5 font-display text-sm backdrop-blur transition-colors hover:text-sun"
        >
          ‹
        </button>
        <button
          type="button"
          data-next
          aria-label="Next photo"
          class="absolute right-2 top-1/2 -translate-y-1/2 rounded-full border border-line bg-bg/80 px-3 py-1.5 font-display text-sm backdrop-blur transition-colors hover:text-sun"
        >
          ›
        </button>
        <div
          data-dots
          class="absolute inset-x-0 bottom-3 flex justify-center gap-2"
        >
          {images.map((_, i) => (
            <span
              data-dot={i}
              class="h-2 w-2 rounded-full bg-muted opacity-50 transition-opacity"
            />
          ))}
        </div>
      </>
    )
  }

  {/* Full-image lightbox: the whole, uncropped photo, browsable like the carousel. */}
  <div
    data-lightbox
    role="dialog"
    aria-modal="true"
    class="fixed inset-0 z-50 hidden cursor-zoom-out items-center justify-center bg-black/92 p-4 sm:p-10"
  >
    <img data-lightbox-img alt={alt} class="max-h-full max-w-full cursor-default object-contain select-none" draggable="false" />
    <button
      type="button"
      data-lightbox-close
      aria-label="Close"
      class="absolute right-4 top-4 grid h-10 w-10 place-items-center rounded-full border border-white/30 bg-black/40 text-lg text-white transition-colors hover:text-sun"
    >
      ✕
    </button>
    {
      !single && (
        <>
          <button
            type="button"
            data-lightbox-prev
            aria-label="Previous photo"
            class="absolute left-3 top-1/2 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full border border-white/30 bg-black/40 text-2xl text-white transition-colors hover:text-sun disabled:opacity-25 sm:left-6"
          >
            ‹
          </button>
          <button
            type="button"
            data-lightbox-next
            aria-label="Next photo"
            class="absolute right-3 top-1/2 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full border border-white/30 bg-black/40 text-2xl text-white transition-colors hover:text-sun disabled:opacity-25 sm:right-6"
          >
            ›
          </button>
          <p data-lightbox-count class="label absolute bottom-4 left-1/2 -translate-x-1/2 text-white/80" aria-live="polite"></p>
        </>
      )
    }
  </div>
</div>

<style>
  .track::-webkit-scrollbar {
    display: none;
  }
  .track {
    scrollbar-width: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    if (!track) return;
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-dot]'));
    const slides = Array.from(track.querySelectorAll<HTMLImageElement>('[data-slide-img]'));

    const setActive = () => {
      const i = Math.round(track.scrollLeft / track.clientWidth);
      dots.forEach((d, di) => (d.style.opacity = di === i ? '1' : '0.5'));
    };
    const go = (dir: number) => {
      track.scrollBy({ left: dir * track.clientWidth, behavior: 'smooth' });
    };

    prev?.addEventListener('click', () => go(-1));
    next?.addEventListener('click', () => go(1));
    track.addEventListener('scroll', () => requestAnimationFrame(setActive), { passive: true });
    setActive();

    // Lightbox: the full, uncropped photo, with its own prev/next (buttons, arrow keys, swipe).
    const lightbox = root.querySelector<HTMLElement>('[data-lightbox]');
    const lightboxImg = root.querySelector<HTMLImageElement>('[data-lightbox-img]');
    const lightboxClose = root.querySelector<HTMLButtonElement>('[data-lightbox-close]');
    const lbPrev = root.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
    const lbNext = root.querySelector<HTMLButtonElement>('[data-lightbox-next]');
    const lbCount = root.querySelector<HTMLElement>('[data-lightbox-count]');
    let current = 0;

    const isOpen = () => !!lightbox && !lightbox.classList.contains('hidden');

    const show = (i: number) => {
      if (!lightboxImg) return;
      current = Math.max(0, Math.min(slides.length - 1, i));
      const img = slides[current];
      lightboxImg.src = img.currentSrc || img.src;
      if (lbPrev) lbPrev.disabled = current === 0;
      if (lbNext) lbNext.disabled = current === slides.length - 1;
      if (lbCount) lbCount.textContent = `${current + 1} / ${slides.length}`;
      // Warm the neighbours so stepping through is instant.
      [current - 1, current + 1].forEach((n) => {
        const s = slides[n];
        if (s) new Image().src = s.currentSrc || s.src;
      });
    };

    const open = (i: number) => {
      if (!lightbox) return;
      show(i);
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
      lightboxClose?.focus();
    };
    const close = () => {
      if (!lightbox) return;
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
      // Leave the inline carousel on the photo that was last viewed.
      track.scrollTo({ left: current * track.clientWidth, behavior: 'instant' as ScrollBehavior });
    };

    slides.forEach((img, i) => img.addEventListener('click', () => open(i)));
    lightbox?.addEventListener('click', close);
    lightboxClose?.addEventListener('click', close);
    lbPrev?.addEventListener('click', (e) => { e.stopPropagation(); show(current - 1); });
    lbNext?.addEventListener('click', (e) => { e.stopPropagation(); show(current + 1); });
    // Don't close when clicking the image itself (only the backdrop / ✕).
    lightboxImg?.addEventListener('click', (e) => e.stopPropagation());

    // Horizontal swipe on the photo steps through.
    let startX: number | null = null;
    lightboxImg?.addEventListener('pointerdown', (e) => { startX = e.clientX; });
    lightboxImg?.addEventListener('pointerup', (e) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 40) show(current + (dx < 0 ? 1 : -1));
    });

    document.addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowRight') show(current + 1);
      else if (e.key === 'ArrowLeft') show(current - 1);
    });
  });
</script>
