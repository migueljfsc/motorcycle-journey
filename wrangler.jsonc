{
  // Moto Journey, served from the root of motojourney.migueljfsc.dev: static assets only, no
  // Worker code. Deployed by .github/workflows/deploy.yml, never by hand. The media bucket and
  // its domain are OpenTofu (infrastructure/terraform/cloudflare).
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "moto-journey",
  "compatibility_date": "2026-09-27",

  // The zone is on this account; the custom domain brings its own DNS record and certificate.
  // It is declared here rather than in OpenTofu because wrangler reconciles a Worker's routes
  // on every deploy, and two owners of one route would undo each other.
  "routes": [{ "pattern": "motojourney.migueljfsc.dev", "custom_domain": true }],
  "workers_dev": false,

  "assets": {
    "directory": "./dist"
  },

  "observability": { "enabled": true }
}
